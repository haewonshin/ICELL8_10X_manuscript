knitr::purl("biotype_analysis.Rmd")
knitr::purl("annotation.R")
knitr::purl("decontX_ambient_RNA.Rmd")
library(dplyr)
library(Seurat)
library(patchwork)
library(ggplot2)
library(harmony)
library(Matrix)
library(BiocParallel)
mem.maxVSize()
new_max_vsize <- 1024 * 1024 * 1024 * 1024
mem.maxVSize(new_max_vsize)
options(future.globals.maxSize = 8000*1024^2)
obj.10x <- readRDS("/Volumes/klavine/Active/Haewon/icell_10x_paper_revisions/objects/10X_clustered.rds")
obj.icell <- readRDS("/Volumes/klavine/Active/Haewon/icell_10x_paper_revisions/objects/ICELL_clustered_no_introns.rds")
# subset one cell type
myeloid.10x <- subset(obj.10x, subset = annot_fig == c("Fibroblast"))
myeloid.icell <- subset(obj.icell, subset = annot_fig == c("Fibroblast"))
# get normalized data
mat.10x <- GetAssayData(myeloid.10x, slot="data")
mat.icell <- GetAssayData(myeloid.icell, slot="data")
# per-gene stats
gene.stats <- function(mat) {
data.frame(
gene = rownames(mat),
mean = Matrix::rowMeans(mat),
var = apply(mat, 1, var)
)
}
stats.10x <- gene.stats(mat.10x)
stats.icell <- gene.stats(mat.icell)
stats.10x$platform <- "10X"
stats.icell$platform <- "ICELL8"
both <- rbind(stats.10x, stats.icell)
p1 <- ggplot(both, aes(mean, var, color=platform)) +
geom_point(alpha=1) +
scale_x_log10() +
scale_y_log10()
ggsave(file.path("/Users/haewonshin/Library/CloudStorage/OneDrive-WashingtonUniversityinSt.Louis/obsidian/my_vault/lab/experiments/01_icell_10x_paper_revisions/figures/mean_variance_fibroblast.pdf"), plot = p1, width = 5, height = 4, dpi = 600)
ggsave(file.path("/Users/haewonshin/Library/CloudStorage/OneDrive-WashingtonUniversityinSt.Louis/obsidian/my_vault/lab/experiments/01_icell_10x_paper_revisions/figures/mean_variance_fibroblast.pdf"), plot = p1, width = 5, height = 3, dpi = 600)
ggsave(file.path("/Users/haewonshin/Library/CloudStorage/OneDrive-WashingtonUniversityinSt.Louis/obsidian/my_vault/lab/experiments/01_icell_10x_paper_revisions/figures/mean_variance_fibroblast.pdf"), plot = p1, width = 8, height = 6, dpi = 600)
ggsave(file.path("/Users/haewonshin/Library/CloudStorage/OneDrive-WashingtonUniversityinSt.Louis/obsidian/my_vault/lab/experiments/01_icell_10x_paper_revisions/figures/mean_variance_fibroblast.pdf"), plot = p1, width = 8, height = 5.5, dpi = 600)
