library(clusterProfiler)
library(org.Hs.eg.db)
library(Seurat)
library(dplyr)
library(ggplot2)
de <- read.csv("/Volumes/klavine/Active/Haewon/icell_10x_paper_revisions/DEGs/icell_unique_myeloid.csv", header = TRUE, row.names = 1) # Import genes
mem.maxVSize()
new_max_vsize <- 1024 * 1024 * 1024 * 1024
mem.maxVSize(new_max_vsize)
options(future.globals.maxSize = 8000*1024^2)
gene_df <- bitr(rownames(de),
fromType="SYMBOL",
toType="ENTREZID",
OrgDb=org.Hs.eg.db)
go <- enrichGO(gene_df$ENTREZID,
OrgDb = org.Hs.eg.db,
ont = "BP")
p1 <- dotplot(go)
ggsave(
"/Users/haewonshin/Library/CloudStorage/OneDrive-WashingtonUniversityinSt.Louis/obsidian/my_vault/lab/experiments/01_icell_10x_paper_revisions/figures/GO_icell_myeloid.pdf",
plot = p1,
width = 10,
height = 6,
device = cairo_pdf
)
